{
  "name": "@prava/worker",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./resolver/catalog": "./src/resolver/catalog.ts",
    "./channels": "./src/channels/index.ts",
    "./conversation/link": "./src/conversation/link.ts",
    "./payments/prava": "./src/payments/prava.ts",
    "./prava-mcp/oauth": "./src/prava-mcp/oauth.ts",
    "./prava-mcp/client": "./src/prava-mcp/client.ts",
    "./prava-mcp/shop": "./src/prava-mcp/shop.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "resolve": "node --env-file-if-exists=../../.env --import tsx src/cli/resolve.ts",
    "eval": "node --env-file-if-exists=../../.env --import tsx src/cli/eval.ts",
    "prava:spike": "node --env-file-if-exists=../../.env --import tsx src/cli/prava-spike.ts",
    "add-find": "node --env-file-if-exists=../../.env --import tsx src/cli/add-find.ts"
  },
  "dependencies": {
    "@prava/db": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "openai": "^4.104.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
