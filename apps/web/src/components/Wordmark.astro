---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  href?: string;
}

const { size = 'md', href = '/' } = Astro.props;

const SIZE = {
  sm: 'text-[18px]',
  md: 'text-[22px]',
  lg: 'text-[30px] sm:text-[36px]',
} as const;
---

<a
  href={href}
  class={`font-display font-semibold lowercase tracking-[-0.03em] text-stone-900 ${SIZE[size]}`}
>
  send<span class="text-gradient">it</span>
</a>
