---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  href?: string;
}

const { size = 'md', href = '/' } = Astro.props;

const SIZE = {
  sm: 'text-[18px]',
  md: 'text-[22px]',
  lg: 'text-[30px] sm:text-[36px]',
} as const;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 font-serif lowercase tracking-[-0.01em] text-ink ${SIZE[size]}`}
>
  <img src="/apple-touch-icon.png" alt="" class="h-7 w-7 rounded-lg" />
  <span>send<span class="text-gradient-accent">it</span></span>
</a>
