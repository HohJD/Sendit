---
import type { InferSelectModel } from 'drizzle-orm';
import type { shares, items } from '@prava/db/schema';

type Share = InferSelectModel<typeof shares>;
type Item = InferSelectModel<typeof items>;

interface Props {
  share: Share;
  items: Item[];
  /** Hides the delete control — for browsing another user's finds (e.g. the demo page). */
  readOnly?: boolean;
}

const { share, items: shareItems, readOnly = false } = Astro.props;

const best = shareItems[0];
const alternates = shareItems.slice(1);

const price = (item: Item) =>
  item.priceAmount && item.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: item.currency }).format(
        Number(item.priceAmount),
      )
    : null;

const buyable = (item: Item) => Boolean(item.priceAmount && item.currency);

// WhatsApp image/text shares have no URL to show — the sender's own words are
// the source instead. An image share waiting on resolution has neither.
const sourceLine = share.sourceUrl || share.inputText || null;
---

<article class="relative rounded-2xl border border-stone-200 bg-white transition-colors hover:border-stone-300">
  {
    !readOnly && (
      <button
        type="button"
        data-delete-share={share.id}
        aria-label="Delete this find"
        class="absolute top-2 right-2 z-10 flex h-7 w-7 items-center justify-center rounded-full border border-stone-300 bg-white/90 text-[13px] text-stone-500 transition hover:border-stone-900 hover:text-stone-900 disabled:opacity-30"
      >
        &times;
      </button>
    )
  }

  {
    share.thumbnail && (
      <div class={`grid gap-px overflow-hidden rounded-t-2xl bg-stone-200 ${best?.imageUrl ? 'grid-cols-2' : 'grid-cols-1'}`}>
        <figure class="relative m-0">
          <img
            src={share.thumbnail}
            alt="What you sent"
            loading="lazy"
            class="aspect-square w-full bg-stone-100 object-cover"
          />
          <figcaption class="absolute top-2 left-2 rounded-full bg-white/90 px-2 py-1 text-[10px] font-medium tracking-wide text-stone-600 uppercase">
            You sent
          </figcaption>
        </figure>

        {best?.imageUrl && (
          <figure class="relative m-0">
            <img
              src={best.imageUrl}
              alt={best.title}
              loading="lazy"
              class="aspect-square w-full bg-stone-100 object-cover"
            />
            <figcaption class="absolute top-2 left-2 rounded-full bg-white/90 px-2 py-1 text-[10px] font-medium tracking-wide text-stone-600 uppercase">
              Match
            </figcaption>
          </figure>
        )}
      </div>
    )
  }
  {
    share.status !== 'resolved' && (
      <div class="p-5">
        <p class="text-[15px] font-medium tracking-[-0.02em] text-stone-700">
          {share.status === 'failed' ? 'Could not read this one' : 'Working on it…'}
        </p>
        {sourceLine &&
          (share.sourceUrl ? (
            <a
              href={share.sourceUrl}
              class="mt-2 block truncate text-[13px] text-stone-400 hover:text-stone-700"
            >
              {share.sourceUrl}
            </a>
          ) : (
            <p class="mt-2 text-[13px] text-stone-400">{sourceLine}</p>
          ))}
        {share.error && <p class="mt-3 text-[13px] text-red-600">{share.error}</p>}
      </div>
    )
  }

  {
    share.status === 'resolved' && !best && (
      <div class="p-5">
        <p class="text-[15px] font-medium tracking-[-0.02em] text-stone-700">No match found</p>
        {sourceLine &&
          (share.sourceUrl ? (
            <a
              href={share.sourceUrl}
              class="mt-2 block truncate text-[13px] text-stone-400 hover:text-stone-700"
            >
              {share.sourceUrl}
            </a>
          ) : (
            <p class="mt-2 text-[13px] text-stone-400">{sourceLine}</p>
          ))}
      </div>
    )
  }

  {
    best && (
      <>
        {best.imageUrl && !share.thumbnail && (
          <img
            src={best.imageUrl}
            alt={best.title}
            loading="lazy"
            class="aspect-square w-full rounded-t-2xl bg-stone-100 object-cover"
          />
        )}
        <div class="p-5">
          {share.resolution === 'similar' && (
            <p class="mb-2 inline-block rounded-full border border-amber-300 px-2.5 py-1 text-[11px] font-medium text-amber-600 uppercase">
              Similar to your send
            </p>
          )}
          {sourceLine && !share.thumbnail && (
            <p class="mb-2 truncate text-[12px] text-stone-400">{sourceLine}</p>
          )}
          <h3 class="text-[18px] leading-[1.1] font-medium tracking-[-0.03em] text-stone-900">
            {best.title}
          </h3>
          <p class="mt-2 text-[13px] tracking-wide text-stone-500 uppercase">{best.merchant}</p>
          {price(best) && (
            <p class="mt-3 text-[30px] leading-none font-medium tracking-[-0.03em] text-stone-900">
              {price(best)}
            </p>
          )}

          {buyable(best) ? (
            <>
              <a
                href={`/checkout/${best.id}`}
                class="bg-gradient-brand mt-5 block rounded-full px-5 py-3 text-center text-[15px] font-medium text-white transition-transform hover:scale-[1.02]"
              >
                Buy in one click
              </a>
              <a
                href={best.productUrl}
                target="_blank"
                rel="noopener nofollow"
                class="mt-2 block rounded-full border border-stone-300 px-5 py-3 text-center text-[13px] font-medium text-stone-700 transition-colors hover:border-stone-900"
              >
                View at {best.merchant ?? 'merchant'}
              </a>
            </>
          ) : (
            <a
              href={best.productUrl}
              target="_blank"
              rel="noopener nofollow"
              class="bg-gradient-brand mt-5 block rounded-full px-5 py-3 text-center text-[15px] font-medium text-white transition-transform hover:scale-[1.02]"
            >
              View at {best.merchant ?? 'merchant'}
            </a>
          )}

          {alternates.length > 0 && (
            <details class="mt-4">
              <summary class="cursor-pointer text-[11px] font-medium tracking-wide text-stone-500 uppercase hover:text-stone-900">
                {alternates.length} other match{alternates.length === 1 ? '' : 'es'}
              </summary>
              <ul class="mt-3 space-y-2">
                {alternates.map((item) => (
                  <li>
                    <a
                      href={item.productUrl}
                      target="_blank"
                      rel="noopener nofollow"
                      class="text-[13px] text-stone-500 hover:text-stone-900"
                    >
                      {item.title} — {item.merchant}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
      </>
    )
  }
</article>

<script>
  // Delegated, because this component repeats across the grid — Astro bundles a
  // component's script once no matter how many instances render.
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-share]');
    if (!button) return;

    if (!confirm('Delete this find? Its matches and any checkouts against them go too.')) return;

    button.disabled = true;
    const res = await fetch(`/api/share/${button.dataset.deleteShare}`, { method: 'DELETE' });

    if (!res.ok) {
      button.disabled = false;
      return;
    }

    const card = button.closest('article');
    const grid = card?.parentElement;
    card?.remove();

    // Nothing left to show means the grid's own empty state should take over,
    // and only the server knows how to render it.
    if (grid && grid.children.length === 0) location.reload();
  });
</script>
