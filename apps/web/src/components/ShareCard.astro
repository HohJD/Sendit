---
import type { InferSelectModel } from 'drizzle-orm';
import type { shares, items } from '@prava/db/schema';

type Share = InferSelectModel<typeof shares>;
type Item = InferSelectModel<typeof items>;

interface Props {
  share: Share;
  items: Item[];
  /** Hides the delete control — for browsing another user's finds (e.g. the demo page). */
  readOnly?: boolean;
}

const { share, items: shareItems, readOnly = false } = Astro.props;

const best = shareItems[0];
const alternates = shareItems.slice(1);

const price = (item: Item) =>
  item.priceAmount && item.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: item.currency }).format(
        Number(item.priceAmount),
      )
    : null;

const buyable = (item: Item) => Boolean(item.priceAmount && item.currency);

// WhatsApp image/text shares have no URL to show — the sender's own words are
// the source instead. An image share waiting on resolution has neither.
const sourceLine = share.sourceUrl || share.inputText || null;
---

<article class="motion relative min-w-0 rounded-2xl border border-hairline bg-white shadow-card hover:-translate-y-0.5 hover:shadow-card-hover">
  <div class="flex min-h-[44px] items-center justify-between gap-2.5 border-b border-hairline px-4 py-3 text-[11px] tracking-[0.12em] uppercase text-ink-soft">
    <span>{share.platform === 'wassist' || share.platform === 'whatsapp' ? 'WhatsApp' : share.platform === 'instagram' ? 'Instagram' : 'Shared find'}</span>
    <span>{share.status === 'resolved' ? 'Reviewed by you next' : share.status === 'failed' ? 'Needs another look' : 'Finding your match'}</span>
  </div>
  {
    !readOnly && (
      <button
        type="button"
        data-delete-share={share.id}
        aria-label="Delete this find"
        class="absolute top-2 right-2 z-10 flex h-7 w-7 items-center justify-center rounded-full border border-hairline bg-white/90 text-[13px] text-ink-soft motion hover:border-ink hover:text-ink disabled:opacity-30"
      >
        &times;
      </button>
    )
  }

  {
    share.thumbnail && (
      <div class={`grid gap-px overflow-hidden rounded-t-2xl bg-hairline ${best?.imageUrl ? 'grid-cols-2' : 'grid-cols-1'}`}>
        <figure class="relative m-0">
          <img
            src={share.thumbnail}
            alt="What you sent"
            loading="lazy"
            class="aspect-square w-full bg-paper object-cover"
          />
          <figcaption class="absolute top-2 left-2 rounded-full bg-white/90 px-2 py-1 text-[10px] font-medium tracking-wide text-ink-soft uppercase">
            You sent
          </figcaption>
        </figure>

        {best?.imageUrl && (
          <figure class="relative m-0">
            <img
              src={best.imageUrl}
              alt={best.title}
              loading="lazy"
              class="aspect-square w-full bg-paper object-cover"
            />
            <figcaption class="absolute top-2 left-2 rounded-full bg-white/90 px-2 py-1 text-[10px] font-medium tracking-wide text-ink-soft uppercase">
              Match
            </figcaption>
          </figure>
        )}
      </div>
    )
  }
  {
    share.status !== 'resolved' && (
      <div class="p-5">
        <p class="text-[15px] font-medium tracking-[-0.02em] text-ink">
          {share.status === 'failed' ? 'Could not read this one' : 'Working on it…'}
        </p>
        {sourceLine &&
          (share.sourceUrl ? (
            <a
              href={share.sourceUrl}
              class="mt-2 block truncate text-[13px] text-ink-soft hover:text-ink"
            >
              {share.sourceUrl}
            </a>
          ) : (
            <p class="mt-2 break-words text-[13px] text-ink-soft">{sourceLine}</p>
          ))}
        {share.error && <p class="mt-3 text-[13px] text-red">{share.error}</p>}
      </div>
    )
  }

  {
    share.status === 'resolved' && !best && (
      <div class="p-5">
        <p class="text-[15px] font-medium tracking-[-0.02em] text-ink">No match found</p>
        {sourceLine &&
          (share.sourceUrl ? (
            <a
              href={share.sourceUrl}
              class="mt-2 block truncate text-[13px] text-ink-soft hover:text-ink"
            >
              {share.sourceUrl}
            </a>
          ) : (
            <p class="mt-2 break-words text-[13px] text-ink-soft">{sourceLine}</p>
          ))}
      </div>
    )
  }

  {
    best && (
      <>
        {best.imageUrl && !share.thumbnail && (
          <img
            src={best.imageUrl}
            alt={best.title}
            loading="lazy"
            class="aspect-square w-full rounded-t-2xl bg-paper object-cover"
          />
        )}
        <div class="p-5">
          {share.resolution === 'similar' && (
            <p class="mb-2 inline-block rounded-full border border-amber/40 bg-amber-soft px-2.5 py-1 text-[11px] font-medium text-amber uppercase">
              Similar to your send
            </p>
          )}
          {sourceLine && !share.thumbnail && (
            <p class="mb-2 truncate text-[12px] text-ink-soft">{sourceLine}</p>
          )}
          <h3 class="font-serif text-[22px] leading-[1.1] tracking-[-0.01em] text-ink">
            {best.title}
          </h3>
          <p class="mt-2 text-[13px] tracking-wide text-ink-soft uppercase">{best.merchant}</p>
          {price(best) && (
            <p class="mt-3 font-serif text-[32px] leading-none tracking-[-0.01em] text-ink">
              {price(best)}
            </p>
          )}

          {buyable(best) ? (
            <>
              <a
                href={`/checkout/${best.id}`}
                class="bg-gradient-accent mt-5 block rounded-full px-5 py-3 text-center text-[15px] font-medium text-ink motion hover:scale-[1.02]"
              >
                Review test checkout
              </a>
              <a
                href={best.productUrl}
                target="_blank"
                rel="noopener nofollow"
                class="mt-2 block rounded-full border border-hairline px-5 py-3 text-center text-[13px] font-medium text-ink motion hover:border-ink"
              >
                View at {best.merchant ?? 'merchant'}
              </a>
            </>
          ) : (
            <a
              href={best.productUrl}
              target="_blank"
              rel="noopener nofollow"
              class="bg-gradient-accent mt-5 block rounded-full px-5 py-3 text-center text-[15px] font-medium text-ink motion hover:scale-[1.02]"
            >
              View at {best.merchant ?? 'merchant'}
            </a>
          )}

          {alternates.length > 0 && (
            <details class="mt-4 border-t border-hairline pt-4">
              <summary class="cursor-pointer text-[11px] font-medium tracking-wide text-ink-soft uppercase hover:text-ink">
                {alternates.length} other match{alternates.length === 1 ? '' : 'es'}
              </summary>
              <ul class="mt-3 space-y-2">
                {alternates.map((item) => (
                  <li>
                    <a
                      href={item.productUrl}
                      target="_blank"
                      rel="noopener nofollow"
                      class="text-[13px] text-ink-soft hover:text-ink"
                    >
                      {item.title} — {item.merchant}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
      </>
    )
  }
</article>

<script>
  // Delegated, because this component repeats across the grid — Astro bundles a
  // component's script once no matter how many instances render.
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-share]');
    if (!button) return;

    if (!confirm('Delete this find? Its matches and any checkouts against them go too.')) return;

    button.disabled = true;
    const res = await fetch(`/api/share/${button.dataset.deleteShare}`, { method: 'DELETE' });

    if (!res.ok) {
      button.disabled = false;
      return;
    }

    const card = button.closest('article');
    const grid = card?.parentElement;
    card?.remove();

    // Nothing left to show means the grid's own empty state should take over,
    // and only the server knows how to render it.
    if (grid && grid.children.length === 0) location.reload();
  });
</script>
