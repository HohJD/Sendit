---
import type { InferSelectModel } from 'drizzle-orm';
import type { items } from '@prava/db/schema';

type Item = InferSelectModel<typeof items>;

interface Props {
  demoItems: Item[];
}

const { demoItems } = Astro.props;

const price = (item: Item) =>
  item.priceAmount && item.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: item.currency }).format(
        Number(item.priceAmount),
      )
    : null;
---

<article class="motion overflow-hidden rounded-3xl shadow-card border border-hairline bg-white">
  <div class="p-8 sm:p-10">
    <p class="text-[12px] font-medium tracking-wide text-amber uppercase">
      Your collection starts here
    </p>
    <h3 class="mt-3 font-serif text-[26px] leading-[1.05] tracking-[-0.01em] sm:text-[32px]">
      Message us on WhatsApp to start
    </h3>
    <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-ink-soft">
      Send a product link or screenshot in your configured WhatsApp chat. If you use the
      Wassist sandbox, message from the phone you signed into Wassist with.
    </p>
    <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-ink-soft">
      Already found something in chat? Open the checkout link Sendit sent you to access that
      conversation’s account. Signing in with a separate email does not automatically link your WhatsApp finds.
    </p>
  </div>

  <div class="border-t border-hairline p-8 sm:p-10">
    <p class="text-[12px] font-medium tracking-wide text-ink-soft uppercase">Try it now</p>
    <h4 class="mt-2 font-serif text-[20px] leading-[1.05] tracking-[-0.01em] sm:text-[24px]">
      Browse a real test user's finds and check one out
    </h4>
    <p class="mt-2 text-[13px] leading-relaxed text-ink-soft">
      Know a test user's Instagram handle? Look up their dashboard and run the real Prava flow on
      what they already sent us.
    </p>
    <form method="GET" action="" class="mt-4 flex max-w-md gap-3" data-demo-lookup-form>
      <input
        type="text"
        name="handle"
        required
        placeholder="their.instagram"
        class="w-full rounded-full border border-hairline bg-white px-4 py-3 text-[15px] text-ink placeholder:text-ink-soft focus:border-ink focus:outline-none"
      />
      <button
        type="submit"
        class="bg-gradient-accent shrink-0 rounded-full px-6 py-3 text-[15px] font-medium text-ink motion hover:scale-[1.02]"
      >
        View
      </button>
    </form>
  </div>

  {
    demoItems.length > 0 && (
      <div class="border-t border-hairline p-8 sm:p-10">
        <p class="text-[12px] font-medium tracking-wide text-ink-soft uppercase">
          Or just pick one
        </p>
        <h4 class="mt-2 font-serif text-[20px] leading-[1.05] tracking-[-0.01em] sm:text-[24px]">
          Recent items from our test users
        </h4>
        <div class="mt-6 grid gap-4 sm:grid-cols-[repeat(2,minmax(0,1fr))] lg:grid-cols-[repeat(3,minmax(0,1fr))]">
          {demoItems.map((item) => (
            <a
              href={`/checkout/${item.id}`}
              class="motion block rounded-2xl border border-hairline bg-white p-4 shadow-card hover:-translate-y-0.5 hover:shadow-card-hover"
            >
              {item.imageUrl && (
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  loading="lazy"
                  class="aspect-square w-full rounded-xl bg-paper object-cover"
                />
              )}
              <p class="mt-3 font-serif text-[18px] leading-tight tracking-[-0.01em] text-ink">
                {item.title}
              </p>
              <p class="mt-1 text-[11px] tracking-wide text-ink-soft uppercase">{item.merchant}</p>
              {price(item) && (
                <p class="mt-2 font-serif text-[22px] leading-none tracking-[-0.01em]">
                  {price(item)}
                </p>
              )}
            </a>
          ))}
        </div>
      </div>
    )
  }
</article>

<script>
  document.querySelector<HTMLFormElement>('[data-demo-lookup-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const input = (event.target as HTMLFormElement).querySelector<HTMLInputElement>('input[name="handle"]');
    const handle = input?.value.trim().replace(/^@/, '');
    if (handle) window.location.href = `/demo/${encodeURIComponent(handle)}`;
  });
</script>
