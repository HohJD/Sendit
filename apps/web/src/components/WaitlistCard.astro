---
import type { InferSelectModel } from 'drizzle-orm';
import type { items } from '@prava/db/schema';

type Item = InferSelectModel<typeof items>;

interface Props {
  demoItems: Item[];
}

const { demoItems } = Astro.props;

const price = (item: Item) =>
  item.priceAmount && item.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: item.currency }).format(
        Number(item.priceAmount),
      )
    : null;
---

<article class="rounded-2xl border border-stone-200 bg-white">
  <div class="p-8 sm:p-10">
    <p class="text-[12px] font-medium tracking-wide text-amber-600 uppercase">
      Not on the test list yet
    </p>
    <h3 class="mt-3 text-[26px] leading-[1.05] font-medium tracking-[-0.03em] sm:text-[32px]">
      Message us on WhatsApp to start
    </h3>
    <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-stone-600">
      While Meta's app is in developer mode, the WhatsApp test number can only talk to numbers
      we've explicitly allowlisted — so your messages won't reach us until you're on the list.
    </p>
    <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-stone-600">
      Email your phone number to
      <a href="mailto:daiwikdomain@gmail.com" class="text-stone-900 underline underline-offset-4">
        daiwikdomain@gmail.com
      </a>
      and we'll add you.
    </p>
  </div>

  <div class="border-t border-stone-200 p-8 sm:p-10">
    <p class="text-[12px] font-medium tracking-wide text-stone-500 uppercase">Try it now</p>
    <h4 class="mt-2 text-[20px] leading-[1.05] font-medium tracking-[-0.03em] sm:text-[24px]">
      Browse a real test user's finds and check one out
    </h4>
    <p class="mt-2 text-[13px] leading-relaxed text-stone-500">
      Know a test user's Instagram handle? Look up their dashboard and run the real Prava flow on
      what they already sent us.
    </p>
    <form method="GET" action="" class="mt-4 flex max-w-md gap-3" data-demo-lookup-form>
      <input
        type="text"
        name="handle"
        required
        placeholder="their.instagram"
        class="w-full rounded-full border border-stone-300 bg-white px-4 py-3 text-[15px] text-stone-900 placeholder:text-stone-400 focus:border-stone-900 focus:outline-none"
      />
      <button
        type="submit"
        class="bg-gradient-brand shrink-0 rounded-full px-6 py-3 text-[15px] font-medium text-white transition-transform hover:scale-[1.02]"
      >
        View
      </button>
    </form>
  </div>

  {
    demoItems.length > 0 && (
      <div class="border-t border-stone-200 p-8 sm:p-10">
        <p class="text-[12px] font-medium tracking-wide text-stone-500 uppercase">
          Or just pick one
        </p>
        <h4 class="mt-2 text-[20px] leading-[1.05] font-medium tracking-[-0.03em] sm:text-[24px]">
          Recent items from our test users
        </h4>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {demoItems.map((item) => (
            <a
              href={`/checkout/${item.id}`}
              class="block rounded-2xl border border-stone-200 bg-white p-4 transition-colors hover:border-stone-300"
            >
              {item.imageUrl && (
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  loading="lazy"
                  class="aspect-square w-full rounded-xl bg-stone-100 object-cover"
                />
              )}
              <p class="mt-3 text-[15px] leading-tight font-medium tracking-[-0.02em] text-stone-900">
                {item.title}
              </p>
              <p class="mt-1 text-[11px] tracking-wide text-stone-500 uppercase">{item.merchant}</p>
              {price(item) && (
                <p class="mt-2 text-[20px] leading-none font-medium tracking-[-0.03em]">
                  {price(item)}
                </p>
              )}
            </a>
          ))}
        </div>
      </div>
    )
  }
</article>

<script>
  document.querySelector<HTMLFormElement>('[data-demo-lookup-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const input = (event.target as HTMLFormElement).querySelector<HTMLInputElement>('input[name="handle"]');
    const handle = input?.value.trim().replace(/^@/, '');
    if (handle) window.location.href = `/demo/${encodeURIComponent(handle)}`;
  });
</script>
