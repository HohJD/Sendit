---
import { db, shares, items, identities } from '@prava/db';
import { and, eq, desc, inArray, asc, ne, isNotNull } from 'drizzle-orm';
import ShareCard from './ShareCard.astro';
import WaitlistCard from './WaitlistCard.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;

const userShares = await db
  .select()
  .from(shares)
  .where(and(eq(shares.userId, userId), ne(shares.status, 'failed')))
  .orderBy(desc(shares.createdAt))
  .limit(60);

const shareItems = userShares.length
  ? await db
      .select()
      .from(items)
      .where(
        inArray(
          items.shareId,
          userShares.map((s) => s.id),
        ),
      )
      .orderBy(asc(items.rank))
  : [];

const byShare = Map.groupBy(shareItems, (item) => item.shareId);

// A signed-in account with no shares and no linked Instagram identity means
// dev-login couldn't resolve an IGSID for this handle — the common case while
// Meta's app is still in developer mode and this account isn't whitelisted.
let hasIdentity = true;
let demoItems: (typeof items.$inferSelect)[] = [];

if (userShares.length === 0) {
  const [identity] = await db
    .select()
    .from(identities)
    .where(eq(identities.userId, userId))
    .limit(1);
  hasIdentity = Boolean(identity);

  if (!hasIdentity) {
    demoItems = await db
      .select()
      .from(items)
      .where(and(isNotNull(items.priceAmount), eq(items.tier, 'buyable')))
      .orderBy(desc(items.createdAt))
      .limit(6);
  }
}
---

{
  userShares.length === 0 ? (
    hasIdentity ? (
      <div class="rounded-3xl border border-dashed border-hairline bg-white px-6 py-16 text-center">
        <span class="text-[11px] font-medium tracking-[0.12em] text-ink-soft uppercase">Room for something good</span>
        <h3 class="mt-4 font-serif text-[28px] tracking-[-0.01em]">Your next find starts with a send.</h3>
        <p class="mx-auto mt-3 max-w-[380px] text-[14px] leading-[1.7] text-ink-soft">Send a product link or screenshot in your connected WhatsApp or Instagram chat. Your matches will appear here.</p>
        <a href="/explore" class="motion mt-5 inline-block text-[13px] font-medium text-ink underline decoration-hairline underline-offset-[5px] hover:opacity-[0.92]">Explore products while you wait <span aria-hidden="true">↗</span></a>
      </div>
    ) : (
      <WaitlistCard demoItems={demoItems} />
    )
  ) : (
    <div class="grid gap-6 sm:grid-cols-[repeat(2,minmax(0,1fr))] lg:grid-cols-[repeat(3,minmax(0,1fr))]">
      {userShares.map((share) => (
        <ShareCard share={share} items={byShare.get(share.id) ?? []} />
      ))}
    </div>
  )
}
