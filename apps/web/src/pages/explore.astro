---
import DashboardShell from '../layouts/DashboardShell.astro';
import { searchByText, type CatalogCandidate } from '@prava/worker/resolver/catalog';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const query = Astro.url.searchParams.get('q')?.trim() ?? '';

let candidates: CatalogCandidate[] = [];
let error: string | null = null;

if (query) {
  try {
    candidates = await searchByText(query);
  } catch (err) {
    error = err instanceof Error ? err.message : 'Search failed';
  }
}

const price = (c: CatalogCandidate) =>
  c.priceAmount && c.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: c.currency }).format(Number(c.priceAmount))
    : null;
---

<DashboardShell title="Explore" active="explore">
  <header class="mb-8">
    <p class="text-[12px] font-medium tracking-wide text-stone-500 uppercase">
      Shopify catalog, no send required
    </p>
    <h1 class="mt-3 text-[36px] leading-[1] font-medium tracking-[-0.03em] sm:text-[44px]">
      Explore
    </h1>
  </header>

  <form method="GET" class="mb-10 flex gap-3">
    <input
      type="text"
      name="q"
      value={query}
      placeholder="wireless headphones under $100"
      class="w-full rounded-full border border-stone-300 bg-white px-4 py-3 text-[15px] text-stone-900 placeholder:text-stone-400 focus:border-stone-900 focus:outline-none"
    />
    <button
      type="submit"
      class="bg-gradient-brand shrink-0 rounded-full px-6 py-3 text-[15px] font-medium text-white transition-transform hover:scale-[1.02]"
    >
      Search
    </button>
  </form>

  {
    error && (
      <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-[13px] text-red-600">{error}</div>
    )
  }

  {
    !error && query && candidates.length === 0 && (
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
        <p class="text-[20px] font-medium tracking-[-0.03em] sm:text-[26px]">No matches</p>
        <p class="mt-3 text-[13px] text-stone-500 sm:text-[15px]">Try a different query.</p>
      </div>
    )
  }

  {
    candidates.length > 0 && (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {candidates.map((c) => (
          <article class="rounded-2xl border border-stone-200 bg-white transition-colors hover:border-stone-300">
            {c.imageUrl && (
              <img
                src={c.imageUrl}
                alt={c.title}
                loading="lazy"
                class="aspect-square w-full rounded-t-2xl bg-stone-100 object-cover"
              />
            )}
            <div class="p-5">
              <h3 class="text-[18px] leading-[1.1] font-medium tracking-[-0.03em] text-stone-900">{c.title}</h3>
              <p class="mt-2 text-[13px] tracking-[-0.02em] text-stone-500 uppercase">{c.merchant}</p>
              {price(c) && (
                <p class="mt-3 text-[30px] leading-none font-medium tracking-[-0.03em] text-stone-900">{price(c)}</p>
              )}
              <a
                href={c.productUrl}
                target="_blank"
                rel="noopener nofollow"
                class="bg-gradient-brand mt-5 block rounded-full px-5 py-3 text-center text-[15px] font-medium text-white transition-transform hover:scale-[1.02]"
              >
                View at {c.merchant ?? 'merchant'}
              </a>
            </div>
          </article>
        ))}
      </div>
    )
  }
</DashboardShell>
