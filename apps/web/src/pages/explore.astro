---
import DashboardShell from '../layouts/DashboardShell.astro';
import { searchByText, type CatalogCandidate } from '@prava/worker/resolver/catalog';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const query = Astro.url.searchParams.get('q')?.trim() ?? '';

let candidates: CatalogCandidate[] = [];
let error: string | null = null;

if (query) {
  try {
    candidates = await searchByText(query);
  } catch (err) {
    error = err instanceof Error ? err.message : 'Search failed';
  }
}

const price = (c: CatalogCandidate) =>
  c.priceAmount && c.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: c.currency }).format(Number(c.priceAmount))
    : null;
---

<DashboardShell title="Explore" active="explore">
  <header class="mb-8">
    <p class="text-[12px] font-medium tracking-wide text-ink-soft uppercase">
      Shopify catalog, no send required
    </p>
    <h1 class="mt-3 text-[36px] leading-[1] font-serif tracking-[-0.01em] sm:text-[44px]">
      Explore
    </h1>
  </header>

  <form method="GET" class="mb-10 flex gap-3">
    <input
      type="text"
      name="q"
      value={query}
      placeholder="wireless headphones under $100"
      class="w-full rounded-full border border-hairline bg-white px-4 py-3 text-[15px] text-ink placeholder:text-ink-soft focus:border-ink focus:outline-none"
    />
    <button
      type="submit"
      class="bg-gradient-accent shrink-0 rounded-full px-6 py-3 text-[15px] font-medium text-ink motion hover:scale-[1.02]"
    >
      Search
    </button>
  </form>

  {
    error && (
      <div class="rounded-2xl border border-red/40 bg-red-soft p-5 text-[13px] text-red">{error}</div>
    )
  }

  {
    !error && query && candidates.length === 0 && (
      <div class="rounded-2xl border border-dashed border-hairline bg-white px-6 py-16 text-center">
        <p class="text-[20px] font-serif tracking-[-0.01em] sm:text-[26px]">No matches</p>
        <p class="mt-3 text-[13px] text-ink-soft sm:text-[15px]">Try a different query.</p>
      </div>
    )
  }

  {
    candidates.length > 0 && (
      <div class="grid gap-6 sm:grid-cols-[repeat(2,minmax(0,1fr))] lg:grid-cols-[repeat(3,minmax(0,1fr))]">
        {candidates.map((c) => (
          <article class="motion rounded-2xl border border-hairline bg-white shadow-card hover:-translate-y-0.5 hover:shadow-card-hover">
            {c.imageUrl && (
              <img
                src={c.imageUrl}
                alt={c.title}
                loading="lazy"
                class="aspect-square w-full rounded-t-2xl bg-paper object-cover"
              />
            )}
            <div class="p-5">
              <h3 class="font-serif text-[22px] leading-[1.1] tracking-[-0.01em] text-ink">{c.title}</h3>
              <p class="mt-2 text-[13px] tracking-[-0.02em] text-ink-soft uppercase">{c.merchant}</p>
              {price(c) && (
                <p class="mt-3 font-serif text-[32px] leading-none tracking-[-0.01em] text-ink">{price(c)}</p>
              )}
              <a
                href={c.productUrl}
                target="_blank"
                rel="noopener nofollow"
                class="bg-gradient-accent mt-5 block rounded-full px-5 py-3 text-center text-[15px] font-medium text-ink motion hover:scale-[1.02]"
              >
                View at {c.merchant ?? 'merchant'}
              </a>
            </div>
          </article>
        ))}
      </div>
    )
  }
</DashboardShell>
