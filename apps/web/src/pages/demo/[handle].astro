---
import DashboardShell from '../../layouts/DashboardShell.astro';
import ShareCard from '../../components/ShareCard.astro';
import { db, shares, items, identities } from '@prava/db';
import { and, eq, desc, inArray, asc, ne } from 'drizzle-orm';
import { resolveIgsid } from '../../lib/instagram.ts';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const { handle } = Astro.params;

let igsid: string | null = null;
let error: string | null = null;

try {
  igsid = await resolveIgsid(handle!);
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

let targetUserId: string | null = null;

if (igsid) {
  const [identity] = await db
    .select()
    .from(identities)
    .where(and(eq(identities.platform, 'instagram'), eq(identities.externalId, igsid)))
    .limit(1);
  targetUserId = identity?.userId ?? null;
}

const userShares = targetUserId
  ? await db
      .select()
      .from(shares)
      .where(and(eq(shares.userId, targetUserId), ne(shares.status, 'failed')))
      .orderBy(desc(shares.createdAt))
      .limit(60)
  : [];

const shareItems = userShares.length
  ? await db
      .select()
      .from(items)
      .where(
        inArray(
          items.shareId,
          userShares.map((s) => s.id),
        ),
      )
      .orderBy(asc(items.rank))
  : [];

const byShare = Map.groupBy(shareItems, (item) => item.shareId);
---

<DashboardShell title={`@${handle} — finds`} active="finds">
  <header class="mb-10">
    <p class="text-[12px] font-medium tracking-wide text-stone-500 uppercase">
      Browsing a test user's finds
    </p>
    <h1 class="mt-3 text-[36px] leading-[1] font-medium tracking-[-0.03em] sm:text-[44px]">
      @{handle}
    </h1>
    <p class="mt-3 max-w-lg text-[15px] leading-relaxed text-stone-500">
      These are real reels this account already sent us. You can run the real Prava checkout on
      any of them — it opens under your own signed-in session, not theirs.
    </p>
  </header>

  {error && <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-[13px] text-red-600">{error}</div>}

  {
    !error && !targetUserId && (
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
        <p class="text-[20px] font-medium tracking-[-0.03em] sm:text-[26px]">No test user found</p>
        <p class="mx-auto mt-3 max-w-sm text-[13px] leading-relaxed text-stone-500 sm:text-[15px]">
          "@{handle}" hasn't messaged us, or hasn't been claimed on our end yet.
        </p>
      </div>
    )
  }

  {
    !error && targetUserId && userShares.length === 0 && (
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
        <p class="text-[20px] font-medium tracking-[-0.03em] sm:text-[26px]">Nothing here yet</p>
      </div>
    )
  }

  {
    userShares.length > 0 && (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {userShares.map((share) => (
          <ShareCard share={share} items={byShare.get(share.id) ?? []} readOnly />
        ))}
      </div>
    )
  }
</DashboardShell>
