---
import Base from '../layouts/Base.astro';
import { BRAND_NAME } from '../components/landing/content.ts';
---

<Base title="Privacy Policy">
  <article class="max-w-none">
    <h1 class="font-serif text-[44px] leading-[1.05] tracking-[-0.01em]">Privacy Policy</h1>
    <p class="mt-1 text-sm text-ink-soft">Last updated 2026-08-01</p>

    <p class="mt-6 text-[15px] leading-[1.7] text-ink-soft">
      {BRAND_NAME} lets you send a product photo or reel (via Instagram or WhatsApp) and get back
      where to buy it.
    </p>

    <h2 class="mt-8 font-serif text-[24px] tracking-[-0.01em]">What we collect</h2>
    <p class="mt-4 text-[15px] leading-[1.7] text-ink-soft">
      When you message us, we receive the content you send (images, video, links, captions) and
      your platform identifier (Instagram-scoped ID or phone number) so we can reply to the right
      person. We store the products we find as a result, tied to your account.
    </p>

    <h2 class="mt-8 font-serif text-[24px] tracking-[-0.01em]">What we don't do</h2>
    <p class="mt-4 text-[15px] leading-[1.7] text-ink-soft">
      We don't sell your data. We don't use your messages for anything other than finding and
      showing you products, and building your own history of what you've sent us.
    </p>

    <h2 class="mt-8 font-serif text-[24px] tracking-[-0.01em]">Payments</h2>
    <p class="mt-4 text-[15px] leading-[1.7] text-ink-soft">
      If you choose to complete a purchase through {BRAND_NAME}, payment credentials are handled
      by our payment processor and are never stored on our servers.
    </p>

    <h2 class="mt-8 font-serif text-[24px] tracking-[-0.01em]">Contact</h2>
    <p class="mt-4 text-[15px] leading-[1.7] text-ink-soft">Questions about this policy: reach out via the account you messaged us from.</p>
  </article>
</Base>
