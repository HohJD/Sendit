---
import DashboardShell from '../layouts/DashboardShell.astro';
import { db, checkouts, items } from '@prava/db';
import { and, desc, eq, gt } from 'drizzle-orm';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const liveSince = new Date(Date.now() - 15 * 60_000);

const rows = await db
  .select({ checkout: checkouts, item: items })
  .from(checkouts)
  .innerJoin(items, eq(checkouts.itemId, items.id))
  .where(and(eq(checkouts.userId, userId), gt(checkouts.createdAt, liveSince)))
  .orderBy(desc(checkouts.createdAt))
  .limit(50);

const LABEL: Record<string, string> = {
  authorizing: 'Awaiting passkey',
  authorized: 'Card minted',
  placed: 'Order placed',
  declined: 'Declined by merchant',
  failed: 'Could not complete',
};

const TONE: Record<string, string> = {
  authorizing: 'border-stone-300 text-stone-500',
  authorized: 'border-stone-900 text-stone-900',
  placed: 'bg-gradient-brand border-transparent text-white',
  declined: 'border-amber-400 text-amber-600',
  failed: 'border-red-300 text-red-600',
};

const REACHED: Record<string, number> = {
  authorizing: 1,
  authorized: 3,
  placed: 5,
  declined: 5,
  failed: 3,
};

type StepState = 'done' | 'warn' | 'blocked' | 'active' | 'pending';

const flowFor = (status: string): { label: string; state: StepState }[] => {
  const labels = ['Session', 'Passkey', 'Card minted', 'Bought', 'Reported'];
  if (status === 'declined') labels[3] = 'Declined';
  if (status === 'failed') labels[3] = 'Agent stalled';

  if (status === 'placed') labels[4] = 'Reported APPROVED';
  if (status === 'declined') labels[4] = 'Reported DECLINED';
  if (status === 'failed') labels[4] = 'Not reported yet';

  const done = REACHED[status] ?? 0;

  return labels.map((label, i) => {
    let state: StepState = 'pending';
    if (status === 'declined' && i === 3) state = 'warn';
    else if (status === 'failed' && i === 3) state = 'blocked';
    else if (i < done) state = 'done';
    else if (i === done) state = 'active';
    return { label, state };
  });
};

const DOT: Record<StepState, string> = {
  done: 'bg-gradient-brand border-transparent',
  warn: 'bg-amber-400 border-amber-400',
  blocked: 'border-amber-400',
  active: 'border-stone-900',
  pending: 'border-stone-300',
};

const TEXT: Record<StepState, string> = {
  done: 'text-stone-600',
  warn: 'text-amber-600',
  blocked: 'text-amber-600',
  active: 'text-stone-900',
  pending: 'text-stone-400',
};

const money = (amount: string | null, currency: string | null) =>
  amount && currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency }).format(Number(amount))
    : null;
---

<DashboardShell title="Checkouts" active="checkouts">
  <header class="mb-10">
    <p class="text-[12px] font-medium tracking-wide text-stone-500 uppercase">
      One-time cards, minted on your passkey
    </p>
    <h1 class="mt-3 text-[36px] leading-[1] font-medium tracking-[-0.03em] sm:text-[44px]">
      Checkouts
    </h1>
  </header>

  {
    rows.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
        <p class="text-[20px] font-medium tracking-[-0.03em] sm:text-[26px]">Nothing in flight</p>
        <p class="mx-auto mt-3 max-w-sm text-[13px] leading-relaxed text-stone-500 sm:text-[15px]">
          Buy one of your finds in a single click and it will show up here while it runs.
        </p>
      </div>
    ) : (
      <ul class="border-t border-stone-200">
        {rows.map(({ checkout, item }) => (
          <li class="border-b border-stone-200 py-6">
            <div class="flex items-start justify-between gap-6">
              <div class="min-w-0">
                <p class="truncate text-[20px] leading-[1.05] font-medium tracking-[-0.04em]">
                  {item.title}
                </p>
                <p class="mt-2 text-[13px] tracking-[-0.02em] text-stone-500 uppercase">
                  {item.merchant}
                  {money(checkout.totalAmount, checkout.currency) && (
                    <span class="text-stone-900"> · {money(checkout.totalAmount, checkout.currency)}</span>
                  )}
                </p>
              </div>

              <span
                class={`shrink-0 rounded-full border px-4 py-1.5 text-[12px] font-medium tracking-wide uppercase ${TONE[checkout.status]}`}
              >
                {LABEL[checkout.status]}
              </span>
            </div>

            <ol class="mt-5 flex flex-wrap items-center gap-y-2">
              {flowFor(checkout.status).map((step, i) => (
                <>
                  {i > 0 && <span class="mx-2 h-px w-4 shrink-0 bg-stone-200 sm:w-6" />}
                  <li class="flex items-center gap-2">
                    <span class={`h-2.5 w-2.5 shrink-0 rounded-full border ${DOT[step.state]}`} />
                    <span
                      class={`text-[12px] font-medium tracking-wide uppercase ${TEXT[step.state]}`}
                    >
                      {step.label}
                    </span>
                  </li>
                </>
              ))}
            </ol>

            {checkout.outcome && <p class="mt-4 text-[13px] text-stone-500">{checkout.outcome}</p>}

            <p class="mt-2 font-mono text-[11px] text-stone-400">
              {checkout.orderId ?? checkout.sessionId}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</DashboardShell>
