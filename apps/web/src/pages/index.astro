---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import Scribble from '../components/Scribble.astro';
import { HOW_IT_WORKS } from '../components/landing/content.ts';

if (Astro.locals.userId) return Astro.redirect('/dashboard');

const GET_ITEMS = [
  {
    title: 'One-time card',
    body: 'A card minted per purchase that works once, at that merchant, for that amount — then it’s dead.',
  },
  {
    title: 'Real storefronts',
    body: 'Matches land on the merchant’s own product page, and the agent drives their actual checkout.',
  },
  {
    title: 'Nothing leaves the chat',
    body: 'Your real card never reaches the merchant — or us. The passkey approval happens on Prava’s surface.',
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>sendit — send a link, get the product</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content="sendit" />
    <meta property="og:site_name" content="sendit" />
    <meta property="og:title" content="sendit — send a link, get the product" />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans bg-paper text-ink antialiased">
    <header class="sticky top-0 z-40 border-b border-hairline bg-paper/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 sm:px-8">
        <Wordmark size="md" />
        <nav class="flex items-center gap-5">
          <a
            href="#how-it-works"
            class="motion hidden text-[13px] font-medium text-ink-soft hover:opacity-[0.92] hover:text-ink sm:inline"
          >
            How it works
          </a>
          <button
            type="button"
            data-login
            class="motion rounded-full bg-gradient-accent px-5 py-2.5 text-[13px] font-medium text-ink hover:scale-[1.02]"
          >
            Sign in
          </button>
        </nav>
      </div>
    </header>

    <section class="mx-auto grid w-full max-w-6xl items-center gap-12 px-4 py-16 sm:px-8 sm:py-24 lg:grid-cols-2">
      <div class="fade-in">
        <h1
          class="font-serif text-[56px] leading-[1.05] tracking-[-0.01em] sm:text-[80px]"
        >
          Send it.<br />We <span class="relative inline-block">find<Scribble class="absolute -bottom-1 left-0 h-[10px] w-full" /></span> it.<br />We buy it.
        </h1>
        <p class="mt-6 max-w-md text-[15px] leading-[1.7] text-ink-soft sm:text-[17px]">
          Message a link or a screenshot on WhatsApp. Sendit
          identifies the product, finds it on a real store, and checks out with a one-time
          Prava card — you only approve.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <button
            type="button"
            data-login
            class="motion rounded-full bg-gradient-accent px-6 py-3 text-[15px] font-medium text-ink hover:scale-[1.02]"
          >
            Sign in
          </button>
          <a
            href="#how-it-works"
            class="motion rounded-full border border-hairline bg-white px-6 py-3 text-[15px] font-medium text-ink hover:border-ink-soft"
          >
            How it works
          </a>
        </div>
        <p class="mt-6 text-[12px] text-ink-soft">
          Sandbox demo — test purchases only, no real money.
        </p>
      </div>

      <!-- CSS-only stand-in for the chat experience -->
      <div class="fade-in mx-auto w-full max-w-[360px] rounded-[36px] border border-hairline bg-white/70 p-5 shadow-[0_1px_2px_rgba(28,27,26,0.04),0_8px_24px_-12px_rgba(28,27,26,0.08)] backdrop-blur">
        <div class="flex items-center gap-2 border-b border-hairline pb-3">
          <span class="h-2 w-2 rounded-full bg-green"></span>
          <span class="text-[13px] font-medium">Sendit</span>
          <span class="ml-auto text-[11px] tracking-[0.12em] text-ink-soft uppercase">WhatsApp</span>
        </div>
        <div class="flex flex-col gap-2.5 pt-4 text-[14px] leading-snug">
          <div class="ml-auto max-w-[75%] rounded-[22px] rounded-tr-md bg-ink px-4 py-3 text-paper shadow-[0_1px_2px_rgba(28,27,26,0.08)]">
            <div class="mb-1.5 flex h-20 w-28 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-[11px] text-paper/70 italic">
              [screenshot of a jacket]
            </div>
            this one?
          </div>
          <div class="max-w-[80%] rounded-[22px] rounded-tl-md border border-hairline bg-white px-4 py-3 text-ink">
            On it — finding that product…
          </div>
          <div class="max-w-[85%] rounded-[22px] rounded-tl-md border border-hairline bg-white px-4 py-3.5">
            <div class="flex items-center gap-3">
              <div class="h-12 w-12 shrink-0 rounded-xl bg-gradient-accent"></div>
              <div class="min-w-0">
                <p class="truncate font-medium text-ink">The Long Haul Jacket</p>
                <p class="text-[12px] text-ink-soft">Taylor Stitch — $128.00</p>
              </div>
            </div>
            <p class="mt-3 text-[12px] text-ink-soft">
              Test purchase, no real money (Prava sandbox).
            </p>
            <div class="mt-3 flex gap-2">
              <span class="rounded-full bg-gradient-accent px-4 py-1.5 text-[12px] font-medium text-ink">
                Approve
              </span>
              <span class="rounded-full border border-hairline bg-white px-4 py-1.5 text-[12px] font-medium text-ink">
                Not this one
              </span>
            </div>
          </div>
          <div class="max-w-[85%] rounded-[22px] rounded-tl-md border border-hairline bg-white px-4 py-3 text-ink">
            Order placed (sandbox). Card was single-use, locked to Taylor Stitch, $128.00.
          </div>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-8 sm:py-24">
      <p class="text-[12px] font-medium tracking-[0.12em] text-ink-soft uppercase">How it works</p>
      <h2 class="mt-3 font-serif text-[36px] leading-[1.05] tracking-[-0.01em] sm:text-[44px]">
        Three messages, one purchase
      </h2>

      <ol class="mt-10 border-t border-hairline">
        {
          HOW_IT_WORKS.map((step) => (
            <li class="flex gap-6 border-b border-hairline py-6 sm:gap-10 sm:py-8">
              <span class="text-gradient-accent shrink-0 font-serif text-[18px] tabular-nums">
                {step.n}
              </span>
              <div>
                <h3 class="font-serif text-[22px] tracking-[-0.01em] sm:text-[24px]">
                  {step.title}
                </h3>
                <p class="mt-2 max-w-lg text-[15px] leading-[1.7] text-ink-soft">
                  {step.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mx-auto w-full max-w-6xl px-4 pb-20 sm:px-8">
      <div class="grid gap-4 sm:grid-cols-3">
        {
          GET_ITEMS.map((item) => (
            <div class="motion rounded-2xl border border-hairline bg-white p-6 shadow-[0_1px_2px_rgba(28,27,26,0.04),0_8px_24px_-12px_rgba(28,27,26,0.08)] hover:-translate-y-0.5 hover:shadow-[0_2px_4px_rgba(28,27,26,0.05),0_16px_32px_-16px_rgba(28,27,26,0.12)]">
              <h3 class="font-serif text-[22px] tracking-[-0.01em]">{item.title}</h3>
              <p class="mt-2 text-[13px] leading-[1.7] text-ink-soft">{item.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <footer class="border-t border-hairline">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-6 sm:px-8">
        <Wordmark size="sm" />
        <p class="text-[12px] text-ink-soft">© 2026</p>
        <a href="/privacy" class="motion text-[12px] text-ink-soft hover:opacity-[0.92] hover:text-ink">
          Privacy
        </a>
      </div>
    </footer>

    <div
      id="login"
      hidden
      class="fixed inset-0 z-[100] flex items-center justify-center bg-ink/40 px-4 backdrop-blur-sm"
    >
      <div class="w-full max-w-md rounded-3xl border border-hairline bg-white p-8 shadow-[0_1px_2px_rgba(28,27,26,0.04),0_8px_24px_-12px_rgba(28,27,26,0.08)]">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-[12px] font-medium tracking-[0.12em] text-ink-soft uppercase">Sign in</p>
            <h2 class="mt-2 font-serif text-[30px] leading-[1.05] tracking-[-0.01em] text-ink">
              Claim your finds
            </h2>
          </div>
          <button
            type="button"
            id="login-close"
            aria-label="Close"
            class="motion text-[15px] font-medium text-ink-soft hover:text-ink"
          >
            &times;
          </button>
        </div>

        <p class="mt-4 text-[13px] leading-[1.7] text-ink-soft">
          Email signs you in. Add the Instagram handle you DM from if you use Instagram.
        </p>

        <form method="POST" action="/dev-login" class="mt-6 space-y-3">
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-full border border-hairline bg-white px-5 py-3 text-[15px] text-ink placeholder:text-ink-soft focus:border-ink focus:outline-none"
          />
          <input
            type="text"
            name="instagram"
            placeholder="your.instagram (optional)"
            class="w-full rounded-full border border-hairline bg-white px-5 py-3 text-[15px] text-ink placeholder:text-ink-soft focus:border-ink focus:outline-none"
          />
          <button
            type="submit"
            class="motion w-full rounded-full bg-gradient-accent px-6 py-3.5 text-[15px] font-medium text-ink hover:scale-[1.01]"
          >
            Continue
          </button>
        </form>
      </div>
    </div>

    <script>
      const panel = document.getElementById('login');

      const open = () => {
        if (!panel) return;
        panel.hidden = false;
        panel.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
      };

      const close = () => {
        if (panel) panel.hidden = true;
      };

      document.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement).closest('[data-login]');
        if (trigger) {
          event.preventDefault();
          return open();
        }
        if ((event.target as HTMLElement).closest('#login-close') || event.target === panel) close();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
    </script>
  </body>
</html>
