---
import '../styles/global.css';
import { LandingExperience } from '../components/landing/LandingExperience.tsx';
import { HOW_IT_WORKS, REEL_VIDEO } from '../components/landing/content.ts';

if (Astro.locals.userId) return Astro.redirect('/dashboard');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SENDIT — send a reel, get the product</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="application-name" content="sendit" />
    <meta property="og:site_name" content="sendit" />
    <meta property="og:title" content="SENDIT — send a reel, get the product" />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-display m-0 bg-white">
    <LandingExperience client:only="react" />

    <section id="how-it-works" class="relative z-30 bg-white px-4 pt-16 pb-24 sm:px-8 sm:pt-24">
      <div class="mx-auto grid w-full max-w-6xl gap-12 lg:grid-cols-[1fr_360px] lg:gap-20">
        <div>
          <p class="text-[11px] font-medium tracking-[-0.02em] text-stone-400 uppercase sm:text-[13px]">
            How it works
          </p>
          <h2
            class="mt-3 text-[44px] leading-[0.9] font-medium tracking-[-0.04em] text-stone-900 sm:text-[72px]"
          >
            Send a reel,<br />get the product
          </h2>

          <ol class="mt-12 border-t border-stone-200">
            {
              HOW_IT_WORKS.map((step) => (
                <li class="flex gap-6 border-b border-stone-200 py-6 sm:gap-10 sm:py-8">
                  <span class="shrink-0 text-[13px] font-medium tracking-[-0.02em] text-stone-400 tabular-nums">
                    {step.n}
                  </span>
                  <div>
                    <h3 class="text-[20px] leading-none font-medium tracking-[-0.04em] text-stone-900 sm:text-[30px]">
                      {step.title}
                    </h3>
                    <p class="mt-3 max-w-lg text-[13px] leading-relaxed text-stone-500 sm:text-[15px]">
                      {step.body}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>

          <button
            type="button"
            data-login
            class="mt-10 flex h-[80px] w-full items-center justify-center rounded-full bg-stone-900 transition-transform hover:scale-[1.01] sm:h-[100px] sm:w-[330px]"
          >
            <span class="text-[48px] leading-none font-medium tracking-[-0.04em] text-white sm:text-[64px]">
              start
            </span>
          </button>
        </div>

        <div class="mx-auto w-full max-w-[320px] lg:mx-0">
          <div class="overflow-hidden rounded-[28px] border border-stone-200 bg-stone-100 shadow-sm">
            <video
              src={REEL_VIDEO}
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              class="aspect-[9/16] h-full w-full object-cover"></video>
          </div>
          <p class="mt-4 text-center text-[11px] tracking-[-0.02em] text-stone-400 uppercase">
            The whole thing, start to finish
          </p>
        </div>
      </div>
    </section>

    <div
      id="login"
      hidden
      class="fixed inset-0 z-[100] flex items-center justify-center bg-stone-900/80 px-4 backdrop-blur"
    >
      <div class="w-full max-w-md bg-white p-8">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-[11px] font-medium tracking-[-0.02em] text-stone-400 uppercase">
              Sign in
            </p>
            <h2
              class="mt-2 text-[30px] leading-none font-medium tracking-[-0.04em] text-stone-900 sm:text-[36px]"
            >
              Claim your finds
            </h2>
          </div>
          <button
            type="button"
            id="login-close"
            aria-label="Close"
            class="text-[15px] font-medium tracking-[-0.02em] text-stone-400 uppercase hover:text-stone-900"
          >
            &times;
          </button>
        </div>

        <p class="mt-4 text-[13px] leading-relaxed text-stone-500">
          Use the Instagram handle you sent the reel from — that is what binds your shares to this
          account.
        </p>

        <form method="POST" action="/dev-login" class="mt-6 space-y-3">
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-full border border-stone-300 px-5 py-3 text-[15px] tracking-[-0.02em] text-stone-900 placeholder:text-stone-400 focus:border-stone-900 focus:outline-none"
          />
          <input
            type="text"
            name="instagram"
            required
            placeholder="your.instagram"
            class="w-full rounded-full border border-stone-300 px-5 py-3 text-[15px] tracking-[-0.02em] text-stone-900 placeholder:text-stone-400 focus:border-stone-900 focus:outline-none"
          />
          <button
            type="submit"
            class="w-full rounded-full bg-stone-900 px-6 py-4 text-[15px] font-medium tracking-[-0.02em] text-white sm:text-[20px]"
          >
            Continue
          </button>
        </form>
      </div>
    </div>

    <script>
      const panel = document.getElementById('login');

      const open = () => {
        if (!panel) return;
        panel.hidden = false;
        panel.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
      };

      const close = () => {
        if (panel) panel.hidden = true;
      };

      document.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement).closest('[data-login]');
        if (trigger) {
          event.preventDefault();
          return open();
        }
        if ((event.target as HTMLElement).closest('#login-close') || event.target === panel) close();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
    </script>
  </body>
</html>
