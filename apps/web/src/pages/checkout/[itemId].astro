---
import '../../styles/global.css';
import Wordmark from '../../components/Wordmark.astro';
import { CheckoutFlow } from '../../components/checkout/CheckoutFlow.tsx';
import { db, items, shares, users, checkouts, identities } from '@prava/db';
import { createSession, purgeEnrolledCards } from '@prava/worker/payments/prava';
import { DEMO_FALLBACK_DIRECT } from '@prava/worker/payments/demo-card';
import { and, eq, inArray } from 'drizzle-orm';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const { itemId } = Astro.params;

const [row] = await db
  .select({ item: items, share: shares })
  .from(items)
  .innerJoin(shares, eq(items.shareId, shares.id))
  .where(eq(items.id, itemId!))
  .limit(1);

// Any signed-in user can check out any resolved item — not just the sender —
// so a judge (who can't send us their own reel while Meta's app is in
// developer mode — see WaitlistCard) can run the actual Prava flow end to end
// against a real test user's item, using their own signed-in session.
if (!row) return new Response('Not found', { status: 404 });

let [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);

// Chat-first accounts arrive with no email, but Prava requires one to open a
// session. Mint the same sandbox placeholder the worker uses on Approve, so a
// user who reaches this page from the dashboard first isn't dead-ended.
if (user && !user.email) {
  const [identity] = await db
    .select({ externalId: identities.externalId })
    .from(identities)
    .where(and(eq(identities.userId, userId), inArray(identities.platform, ['wassist', 'whatsapp'])))
    .limit(1);
  const email = `wa-${identity?.externalId ?? userId}@sendit.app`;
  [user] = await db.update(users).set({ email }).where(eq(users.id, userId)).returning();
}

const { item } = row;

let error: string | null = null;
let session: Awaited<ReturnType<typeof createSession>> | null = null;

if (!item.priceAmount || !item.currency) {
  error = 'This match has no price, so it cannot be checked out.';
} else if (!user?.email) {
  error = 'Your account has no email address, which Prava requires to open a session.';
} else {
  try {
    // A card left half-enrolled by a failed device binding traps every later
    // session for this customer id (see purgeEnrolledCards) — start clean.
    await purgeEnrolledCards(userId);
    // Fresh Prava customer id per attempt: a card left half-enrolled by an
    // aborted passkey step is bound to the customer id, and every later
    // session on that id then dies at authentication. A new id starts clean.
    session = await createSession({
      userId: `${userId}-${Date.now().toString(36)}`,
      userEmail: user.email,
      totalAmount: item.priceAmount,
      currency: item.currency,
      merchant: {
        name: item.merchant ?? 'Unknown merchant',
        url: item.productUrl,
        countryCodeIso2: 'US',
      },
      callbackUrl: (() => {
        const base = import.meta.env.PRAVA_CALLBACK_URL ?? process.env.PRAVA_CALLBACK_URL;
        return base ? `${base}?to=${encodeURIComponent(Astro.url.origin)}` : undefined;
      })(),
      products: [
        {
          description: item.title,
          unitPrice: item.priceAmount,
          quantity: 1,
          productId: item.catalogProductId ?? undefined,
        },
      ],
    });

    await db.insert(checkouts).values({
      userId,
      itemId: item.id,
      sessionId: session.sessionId,
      orderId: session.orderId,
      totalAmount: item.priceAmount,
      currency: item.currency,
      merchantUrl: item.productUrl,
    });
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const priceLabel =
  item.priceAmount && item.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: item.currency }).format(
        Number(item.priceAmount),
      )
    : '';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Checkout — {item.title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content="sendit" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta property="og:site_name" content="sendit" />
    <meta property="og:image" content="/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans min-h-dvh bg-[#FAF7F2] text-ink antialiased">
    <header class="sticky top-0 z-40 border-b border-hairline bg-white/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3 sm:px-8">
        <Wordmark size="md" href="/dashboard" />
        <a
          href="/dashboard"
          class="rounded-full border border-hairline px-4 py-1.5 text-[12px] font-medium text-ink motion hover:border-ink"
        >
          Back to finds
        </a>
      </div>
    </header>
    {session && (
        <CheckoutFlow
          client:load
          fallbackDirect={DEMO_FALLBACK_DIRECT()}
          sessionId={session.sessionId}
          checkoutUrl={session.iframeUrl}
          expiresAt={session.expiresAt}
          orderId={session.orderId}
          itemId={item.id}
          title={item.title}
          merchant={item.merchant}
          imageUrl={item.imageUrl}
          productUrl={item.productUrl}
          priceLabel={priceLabel}
          email={user!.email!}
          shipping={user?.shipping ?? null}
        />
      )
    }

    {
      error && (
        <div class="mx-auto flex max-w-xl flex-col justify-center px-4 py-16 sm:px-8 sm:py-24">
          <p class="text-[12px] font-medium tracking-wide text-ink-soft uppercase">
            Checkout could not start
          </p>
          <h1 class="mt-3 text-[30px] leading-[0.95] font-serif tracking-[-0.01em] sm:text-[44px]">
            {item.title}
          </h1>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">{error}</p>
          <a
            href="/dashboard"
            class="mt-8 block rounded-full border border-hairline px-6 py-3.5 text-center text-[15px] font-medium text-ink motion hover:border-ink"
          >
            Back to finds
          </a>
        </div>
      )
    }
  </body>
</html>
