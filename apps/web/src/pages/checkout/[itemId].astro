---
import '../../styles/global.css';
import { CheckoutFlow } from '../../components/checkout/CheckoutFlow.tsx';
import { db, items, shares, users, checkouts } from '@prava/db';
import { createSession } from '@prava/worker/payments/prava';
import { eq } from 'drizzle-orm';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const { itemId } = Astro.params;

const [row] = await db
  .select({ item: items, share: shares })
  .from(items)
  .innerJoin(shares, eq(items.shareId, shares.id))
  .where(eq(items.id, itemId!))
  .limit(1);

// Any signed-in user can check out any resolved item — not just the sender —
// so a judge (who can't send us their own reel while Meta's app is in
// developer mode — see WaitlistCard) can run the actual Prava flow end to end
// against a real test user's item, using their own signed-in session.
if (!row) return new Response('Not found', { status: 404 });

const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);

const { item } = row;

let error: string | null = null;
let session: Awaited<ReturnType<typeof createSession>> | null = null;

if (!item.priceAmount || !item.currency) {
  error = 'This match has no price, so it cannot be checked out.';
} else if (!user?.email) {
  error = 'Your account has no email address, which Prava requires to open a session.';
} else {
  try {
    session = await createSession({
      userId,
      userEmail: user.email,
      totalAmount: item.priceAmount,
      currency: item.currency,
      merchant: {
        name: item.merchant ?? 'Unknown merchant',
        url: item.productUrl,
        countryCodeIso2: 'US',
      },
      callbackUrl: (() => {
        const base = import.meta.env.PRAVA_CALLBACK_URL ?? process.env.PRAVA_CALLBACK_URL;
        return base ? `${base}?to=${encodeURIComponent(Astro.url.origin)}` : undefined;
      })(),
      products: [
        {
          description: item.title,
          unitPrice: item.priceAmount,
          quantity: 1,
          productId: item.catalogProductId ?? undefined,
        },
      ],
    });

    await db.insert(checkouts).values({
      userId,
      itemId: item.id,
      sessionId: session.sessionId,
      orderId: session.orderId,
      totalAmount: item.priceAmount,
      currency: item.currency,
      merchantUrl: item.productUrl,
    });
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const priceLabel =
  item.priceAmount && item.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: item.currency }).format(
        Number(item.priceAmount),
      )
    : '';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Checkout — {item.title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content="sendit" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:site_name" content="sendit" />
    <meta property="og:image" content="/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-display min-h-dvh bg-black text-white antialiased">
    {session && (
        <CheckoutFlow
          client:load
          sessionId={session.sessionId}
          checkoutUrl={session.iframeUrl}
          expiresAt={session.expiresAt}
          orderId={session.orderId}
          itemId={item.id}
          title={item.title}
          merchant={item.merchant}
          imageUrl={item.imageUrl}
          productUrl={item.productUrl}
          priceLabel={priceLabel}
          email={user!.email!}
          shipping={user?.shipping ?? null}
        />
      )
    }

    {
      error && (
        <div class="mx-auto flex min-h-dvh max-w-xl flex-col justify-center px-4 sm:px-8">
          <p class="text-[11px] font-medium tracking-[-0.02em] text-white/40 uppercase sm:text-[13px]">
            Checkout could not start
          </p>
          <h1 class="mt-3 text-[30px] leading-[0.95] font-medium tracking-[-0.04em] sm:text-[44px]">
            {item.title}
          </h1>
          <p class="mt-4 text-[15px] leading-relaxed text-white/60">{error}</p>
          <a
            href="/dashboard"
            class="mt-8 block rounded-full bg-white px-6 py-4 text-center text-[15px] font-medium tracking-[-0.02em] text-black sm:text-[20px]"
          >
            Back to finds
          </a>
        </div>
      )
    }
  </body>
</html>
