---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content="sendit" />
    <meta name="theme-color" content="#fafaf9" />
    <meta property="og:site_name" content="sendit" />
    <meta property="og:title" content={title} />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-display h-full bg-[#fafaf9] text-stone-900 antialiased">
    <header class="border-b border-stone-200 bg-white/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-3 sm:px-8">
        <Wordmark size="sm" />
        <a href="/" class="text-[13px] font-medium text-stone-500 transition-colors hover:text-stone-900">
          Back
        </a>
      </div>
    </header>
    <div class="mx-auto max-w-5xl px-4 py-8 sm:px-8">
      <slot />
    </div>
  </body>
</html>
