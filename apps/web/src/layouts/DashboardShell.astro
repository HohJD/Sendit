---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
  active: 'finds' | 'explore' | 'checkouts';
}

const { title, active } = Astro.props;

const TABS = [
  { key: 'finds', label: 'Finds', href: '/dashboard' },
  { key: 'explore', label: 'Explore', href: '/explore' },
  { key: 'checkouts', label: 'Checkouts', href: '/checkouts' },
] as const;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content="sendit" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta property="og:site_name" content="sendit" />
    <meta property="og:title" content={title} />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans min-h-full bg-paper text-ink antialiased">
    <header class="sticky top-0 z-40 border-b border-hairline bg-paper/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3 sm:px-8">
        <Wordmark size="md" href="/dashboard" />
        <nav class="hidden items-center gap-1 sm:flex">
          {
            TABS.map((tab) => (
              <a
                href={tab.href}
                aria-current={active === tab.key ? 'page' : undefined}
                class:list={[
                  'motion relative px-4 py-2 text-[14px] font-medium',
                  active === tab.key
                    ? 'text-ink after:bg-gradient-accent after:absolute after:inset-x-3 after:bottom-0 after:h-[2px] after:rounded-full'
                    : 'text-ink-soft hover:opacity-[0.92] hover:text-ink',
                ]}
              >
                {tab.label}
              </a>
            ))
          }
        </nav>
        <a
          href="/logout"
          class="motion rounded-full border border-hairline bg-white px-4 py-1.5 text-[12px] font-medium text-ink hover:border-ink-soft"
        >
          Sign out
        </a>
      </div>
      <nav class="flex gap-1 overflow-x-auto border-t border-hairline px-4 py-1 sm:hidden">
        {
          TABS.map((tab) => (
            <a
              href={tab.href}
              aria-current={active === tab.key ? 'page' : undefined}
              class:list={[
                'relative shrink-0 px-3 py-2 text-[14px] font-medium',
                active === tab.key
                  ? 'text-ink after:bg-gradient-accent after:absolute after:inset-x-2 after:bottom-0 after:h-[2px] after:rounded-full'
                  : 'text-ink-soft',
              ]}
            >
              {tab.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-8 sm:py-12">
      <slot />
    </main>
  </body>
</html>
